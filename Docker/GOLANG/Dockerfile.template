
ARG PRIVATE_REGISTRY=""
ARG GOLANG_VERSION="1.27.1"
ARG DEBIAN_VERSION="trixie"

FROM ${PRIVATE_REGISTRY}golang:${GOLANG_VERSION}-${DEBIAN_VERSION}

ENV DIR_GOLANG_CODE=/go/src/ \
    GOPATH=/go \
    USER=golang \
    UID=1000 \
    GID=1000
 
# %COPY_SRC_CMD%
# %COPY_GPG_CMD%

RUN apt-get update && apt-get install -y --no-install-recommends \ 
            git gcc openssh-client make pandoc sudo strace inetutils-ping \
            btop jq inetutils-ping telnet tcptraceroute

RUN addgroup "${USER}" && \
    adduser --disabled-password --home "/home/${USER}" --ingroup "${USER}" --uid "${UID}" "${USER}"

RUN chown -R "${USER}:${USER}" ${GOPATH}

COPY --chown="${USER}:${USER}" --chmod="0644" bashrc.sh /home/${USER}/.bashrc

RUN echo 'golang   ALL=NOPASSWD:ALL' > /etc/sudoers.d/golang && chmod 440 /etc/sudoers.d/golang

RUN /usr/local/go/bin/go install -v github.com/ramya-rao-a/go-outline@latest \
 && /usr/local/go/bin/go install -v golang.org/x/tools/gopls@latest \
 && /usr/local/go/bin/go install -v github.com/go-delve/delve/cmd/dlv@latest \
 && /usr/local/go/bin/go install -v honnef.co/go/tools/cmd/staticcheck@latest \
 && /usr/local/go/bin/go install -v github.com/sqlc-dev/sqlc/cmd/sqlc@latest

COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint

WORKDIR ${DIR_GOLANG_CODE}
USER ${USER}

ENTRYPOINT ["/usr/local/bin/entrypoint"]
